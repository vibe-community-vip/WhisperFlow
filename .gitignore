# Entorno virtual (creado por setup.ps1 / install.sh)
venv/
.venv/
venv-*/
env/

# Secretos locales (NUNCA commitear .env — contiene la API key)
.env

# Historial de transcripciones (generado por la app)
transcripciones.md

# Historial de recall para Ctrl+Alt+Z (generado por la app, ver core/recall.py)
last_recordings.json

# Bytecode de Python
__pycache__/
*.py[cod]
*$py.class

# Logs de depuración (ver CLAUDE.md > "Cómo probar cambios")
debug.log
debug_err.log

# Cachés locales que puedan generarse dentro de la carpeta
.cache/
*.egg-info/

# Basura del sistema / editores
.DS_Store
Thumbs.db
.vscode/
.idea/

# Diccionario personal (nombres de clientes, proyectos, jerga propia).
# Se crea copiando dictionary.example.txt; NO se versiona a propósito.
dictionary.txt
