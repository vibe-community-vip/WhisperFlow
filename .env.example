# ---------------------------------------------------------------------------
# Configuración de WhisperFlow local.
# Copia este archivo a ".env" (en esta misma carpeta) y edita lo que quieras;
# la app lo carga al arrancar — no hace falta tocar variables de entorno del SO.
#
# Estado por fase (rama refactor/cross-platform):
#   * Fase 0/1: estas claves todavía NO se leen (la app sigue usando las
#     constantes de whisperflow.py). Quedan como adelanto.
#   * Fase 2: WHISPERFLOW_MODEL_SIZE y WHISPERFLOW_LANGUAGE pasan a usarse.
#   * Fase 3: todo lo del LLM (backend/modelos/keys) pasa a usarse.
# ---------------------------------------------------------------------------

# --- Transcripción (faster-whisper) ---
# tiny | base | small | medium | large-v3
# En Mac (Apple Silicon, sin CUDA) recomendamos "base" o "tiny": más liviano.
WHISPERFLOW_MODEL_SIZE=small
WHISPERFLOW_LANGUAGE=es

# --- Backend de reescritura de tono ---
# auto   = Ollama si responde en localhost:11434; si no, OpenAI si hay key; si no, none.
# ollama | openai | none  fuerza uno concreto.
WHISPERFLOW_LLM_BACKEND=auto

# --- Ollama (LLM local, recomendado: offline y gratis) ---
WHISPERFLOW_OLLAMA_BASE_URL=http://localhost:11434/v1
# Alternativas con más calidad (y más RAM): qwen2.5:7b, llama3.1:8b
WHISPERFLOW_OLLAMA_MODEL=qwen2.5:3b

# --- OpenAI (opcional, cloud/pago) ---
WHISPERFLOW_OPENAI_MODEL=gpt-4.1-nano
OPENAI_API_KEY=

# --- macOS: backend de hotkeys (solo Mac) ---
# cgevent (default, recomendado) = nativo vía CGEventTap: SUPRIME las tone-keys
#   (,/./-) mientras grabas (igual que Windows) y es robusto con pyobjc.
# pynput = fallback (NO suprime tone-keys; puede crashear según versiones).
WHISPERFLOW_MAC_HOTKEY=cgevent

# --- Historial de transcripciones (markdown) ---
# Cada transcripción se anexa a un archivo markdown con fecha/hora y perfil.
WHISPERFLOW_HISTORY=1                       # 1=activado (default), 0=desactivado
WHISPERFLOW_HISTORY_FILE=                   # vacío => <carpeta del proyecto>/transcripciones.md (acepta ~)
