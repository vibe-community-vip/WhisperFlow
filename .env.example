# ---------------------------------------------------------------------------
# Configuración de WhisperFlow local.
# Copia este archivo a ".env" (en esta misma carpeta) y edita lo que quieras;
# la app lo carga al arrancar — no hace falta tocar variables de entorno del SO.
# Prioridad: variable del SO > .env > default.
# ---------------------------------------------------------------------------

# --- Transcripción ---
WHISPERFLOW_LANGUAGE=es

# Motor ASR. En Apple Silicon, faster-whisper es CPU-only; mlx-whisper USA LA GPU
# (Metal) y es mucho más rápido. "" (auto) = mlx en Mac arm64, faster_whisper en el resto.
# Forzá con: mlx | faster_whisper
WHISPERFLOW_ASR_ENGINE=

# Modelo para faster-whisper (CPU/CUDA): tiny | base | small | medium | large-v3 | large-v3-turbo
#
# El default es "medium" porque es el que MIDIÓ mejor en una GPU NVIDIA de portátil
# (RTX 4050, 6 GB) sobre frases en español con vocabulario técnico:
#
#     modelo            WER     latencia mediana   VRAM
#     small            7.8%          0.48 s        554 MB   <- el default anterior
#     medium           2.3%          0.94 s       1472 MB   <- 3x menos errores
#     large-v3-turbo   5.9%          0.68 s       1574 MB
#     large-v3         3.9%          1.41 s       2976 MB
#
# Con CPU o una GPU más chica, "small" sigue siendo la opción sensata (medium en CPU
# puede tardar varios segundos). Medí en TU máquina y con TU voz:
#     python scripts/bench_models.py --record --audio-dir bench_audio
WHISPERFLOW_MODEL_SIZE=medium
# Ancho del beam del decodificador: más alto = un poco más preciso y más lento.
WHISPERFLOW_BEAM_SIZE=5
# Modelo para mlx (GPU Apple Silicon). Más liviano: mlx-community/whisper-small-mlx o whisper-base-mlx
WHISPERFLOW_MLX_MODEL=mlx-community/whisper-large-v3-mlx-4bit

# --- Micrófono: captura permanente + pre-roll ---
# Abrir el micrófono en el momento de pulsar el atajo cuesta ~120 ms reales (medido
# en Windows/MME) y ese audio se perdía: las primeras sílabas no se grababan. Con el
# micrófono armado desde el arranque no se pierde nada, y el pre-roll rescata además
# lo que dijiste justo ANTES de pulsar.
# Contrapartida: el indicador de "micrófono en uso" del SO queda encendido siempre.
# El audio vive solo en un buffer en memoria que se descarta solo; no se escribe a disco.
WHISPERFLOW_MIC_ALWAYS_ON=1                    # 0 = abrir/cerrar el micrófono en cada dictado
WHISPERFLOW_PREROLL_MS=350                     # cuánto audio previo al atajo se conserva

# --- Beeps ---
# Push-to-talk suena un bip; manos libres suena UN bip distinto (más grave y largo).
# Como entrar a manos libres es "Ctrl+Win" y después "Espacio", el bip de push-to-talk
# se difiere estos ms: si el Espacio llega dentro de la ventana, ese bip se cancela y
# solo suena el de manos libres. Solo se difiere el SONIDO: la grabación arranca ya.
# 0 = bip inmediato (vuelven a oírse dos tonos al entrar a manos libres).
WHISPERFLOW_HANDSFREE_GRACE_MS=220

# --- VAD (detección de voz por energía; evita alucinaciones de Whisper en silencio) ---
# Whisper genera texto repetido sobre audio casi mudo. Esto descarta la captura ANTES
# de transcribir si no hay tramas con energía de voz. Medido: silencio ~0.003, voz ~0.1-0.2.
# Si te rechazara dictado real, bajá el umbral; o WHISPERFLOW_VAD=0 para desactivarlo.
WHISPERFLOW_VAD=1                              # 1=activado (default), 0=desactivado
WHISPERFLOW_VAD_THRESHOLD=0.008                # RMS por trama (float32). Subilo si hay ruido de fondo
WHISPERFLOW_VAD_MIN_FRAMES=3                   # tramas mínimas sobre el umbral (descarta clicks)
WHISPERFLOW_VAD_FRAME_MS=30                    # tamaño de trama de análisis

# --- Atajos configurables (nombres: super=Win/Cmd, ctrl, alt, shift, space, o un carácter) ---
# Una misma config sirve en Windows/Mac/Linux. Cambialos si chocan con atajos del SO.
WHISPERFLOW_PTT_KEYS=super,ctrl          # modificadores para push-to-talk
WHISPERFLOW_HANDSFREE_KEY=space          # asciende a manos libres (con PTT sostenido)
WHISPERFLOW_REPASTE_KEYS=ctrl,alt,z      # acorde para re-pegar el último texto

# --- macOS: backend de hotkeys (solo Mac) ---
# cgevent (default, recomendado) = nativo vía CGEventTap, robusto con pyobjc.
# pynput = fallback (puede crashear según versiones).
WHISPERFLOW_MAC_HOTKEY=cgevent

# --- Historial de transcripciones (markdown) ---
# Cada transcripción se anexa a un archivo markdown con fecha/hora.
WHISPERFLOW_HISTORY=1                       # 1=activado (default), 0=desactivado
WHISPERFLOW_HISTORY_FILE=                   # vacío => <carpeta del proyecto>/transcripciones.md

# --- Debug ---
# 1 = loguea cada evento crudo de teclado por consola (útil para depurar atajos).
WHISPERFLOW_DEBUG=0
